# Supabase: Project Settings > API
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Email of the ONE researcher account you create in Supabase (Authentication > Users).
# The researcher passkey is that account's password. Also turn off sign-ups.
VITE_RESEARCHER_EMAIL="researchers@example.com"
